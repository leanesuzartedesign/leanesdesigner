---
import { getImage } from "astro:assets";
import SectionHead from "./SectionHead.astro";
import EventosFolders from "./EventosFolders";
import { eventos } from "../data/cases";

/**
 * Identidade visual e material gráfico de eventos — cada projeto é uma
 * "pasta" que abre com física de mola de verdade (Framer Motion) e as
 * peças saem em leque, arrastáveis; puxar o painel pra baixo fecha de
 * novo. A interação mora em EventosFolders.tsx (ilha React) — este
 * arquivo só prepara os dados (imagens otimizadas) e decide se a seção
 * aparece.
 *
 * A seção só renderiza quando pelo menos uma pasta tem peça de verdade —
 * enquanto o material de um evento ainda não subiu pro repositório
 * (ver `eventos` em `data/cases.ts`), ele simplesmente não é listado, em
 * vez de mostrar uma pasta vazia no ar.
 */
const comPecas = eventos.filter((e) => e.pecas.length > 0);

const eventosParaIlha = await Promise.all(
  comPecas.map(async (evento) => ({
    slug: evento.slug,
    nome: evento.nome,
    fotos: await Promise.all(
      evento.pecas.map(async (peca) => {
        const [miniatura, grande] = await Promise.all([
          getImage({ src: peca, width: 360 }),
          getImage({ src: peca, width: 1200 }),
        ]);
        return {
          src: miniatura.src,
          width: miniatura.attributes.width,
          height: miniatura.attributes.height,
          srcGrande: grande.src,
          alt: `Peça gráfica — ${evento.nome}`,
        };
      }),
    ),
  })),
);
---

{
  eventosParaIlha.length > 0 && (
    <section class="eventos" aria-labelledby="eventos-title">
      <SectionHead index="06" label="Eventos e campanhas" id="eventos-title" />
      <p class="linha-apoio">
        Identidade visual e material gráfico para eventos e campanhas: do
        conceito ao impresso, em outdoor, ambientes e painéis.
      </p>

      <EventosFolders eventos={eventosParaIlha} client:visible />
    </section>
  )
}

<style>
  .eventos {
    padding: var(--section-y) 0;
  }

  .eventos :global(.head) {
    margin-inline: var(--gutter);
  }

  .linha-apoio {
    margin: 0 var(--gutter) clamp(1.5rem, 3vw, 2.5rem);
    color: var(--ink-soft);
    max-width: var(--measure);
  }
</style>
