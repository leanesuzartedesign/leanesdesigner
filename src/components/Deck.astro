---
import { Image } from "astro:assets";
import SectionHead from "./SectionHead.astro";
import { deck } from "../data/cases";

/**
 * Apresentação comercial no formato "Carousel 02" do frameblox kit: um anel
 * 3D. As páginas ficam nas faces de um cilindro e o anel gira sozinho — a da
 * frente aparece inteira, as laterais vão se fechando em perspectiva.
 *
 * Medido na referência: `preserve-3d` com perspectiva de 1200px e cartões em
 * `rotateY` (0°, 60°, 80°…) sobre um raio fixo. Lá o giro é feito por
 * JavaScript; aqui é um `@keyframes` de `rotateY(-360deg)`.
 *
 * O raio vem da trigonometria do polígono: para N faces de largura L sem se
 * atravessarem, R = (L/2) / tan(180°/N). Com 8 páginas, R = L × 1,2071.
 */
const slides = deck.map((src, i) => ({
  src,
  alt:
    i === 0
      ? "Capa de apresentação comercial para empresa de dados do setor automotivo"
      : `Página ${i + 1} da apresentação comercial`,
}));

const passo = 360 / slides.length;
---

<section class="deck" aria-labelledby="deck-title">
  <SectionHead index="03" label="Apresentação comercial" id="deck-title" />

  <div class="palco">
    <ul class="anel">
      {
        slides.map((s, i) => (
          <li style={`--angulo:${i * passo}deg`}>
            <Image
              src={s.src}
              alt={s.alt}
              widths={[400, 700, 1000]}
              sizes="(min-width: 64rem) 34vw, 74vw"
              loading="lazy"
            />
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .deck {
    padding: var(--section-y) var(--gutter);
    overflow: hidden;
  }

  .palco {
    /* Mesma perspectiva medida na referência. */
    perspective: 1200px;
    perspective-origin: 50% 50%;
    display: grid;
    place-items: center;
    /* Altura reservada: o anel é absoluto e não empurra o fluxo. */
    height: clamp(15rem, 42svh, 26rem);
  }

  .anel {
    --carta: clamp(14rem, 38vw, 34rem);
    /* R = (L/2) / tan(180/8) → L × 1,2071 */
    --raio: calc(var(--carta) * 1.2071);

    position: relative;
    list-style: none;
    margin: 0;
    padding: 0;
    width: var(--carta);
    aspect-ratio: 16 / 9;
    transform-style: preserve-3d;
    /* O anel recua o próprio raio: sem isso a face da frente fica em
       z = +raio e a perspectiva a amplia quase o dobro, estourando a altura
       da seção. Recuado, a página da frente aparece em tamanho real. */
    transform: translateZ(calc(var(--raio) * -1));
  }

  li {
    position: absolute;
    inset: 0;
    transform: rotateY(var(--angulo)) translateZ(var(--raio));
    /* As páginas do lado de trás somem em vez de aparecerem espelhadas. */
    backface-visibility: hidden;
  }

  :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: 1rem;
    box-shadow: 0 1rem 2.5rem rgb(0 0 0 / 0.2);
    transition: filter 0.45s ease;
  }

  @media (prefers-reduced-motion: no-preference) {
    .anel {
      animation: girar 40s linear infinite;
    }

    /* Parar para poder olhar a página da frente. */
    .palco:hover .anel {
      animation-play-state: paused;
    }
  }

  /* No celular a página da frente vale mais que a folga lateral do anel. */
  @media (max-width: 47.999rem) {
    .anel {
      --carta: 74vw;
    }
  }

  @keyframes girar {
    from {
      transform: translateZ(calc(var(--raio) * -1)) rotateY(0deg);
    }
    to {
      transform: translateZ(calc(var(--raio) * -1)) rotateY(-360deg);
    }
  }
</style>
