---
import { Image } from "astro:assets";
import SectionHead from "./SectionHead.astro";
import { documentos } from "../data/cases";

/**
 * Apresentações e relatórios institucionais em slide — em qualquer tamanho
 * de tela, numa ÚNICA linha (um só slider, não um por empresa empilhado —
 * isso lia como duas linhas no desktop). As peças de cada empresa continuam
 * juntas e em ordem dentro da sequência, só não têm mais um trilho próprio.
 *
 * Cada peça é uma parada individual do slide — não um grupo fixo de 4. Isso
 * importa porque quantas peças cabem visíveis por vez MUDA com a largura da
 * tela (1 no celular, 2 no tablet, 4 no desktop). Uma primeira versão
 * agrupava sempre de 4 em 4 e só ajustava colunas via grid — no celular isso
 * empilhava as 4 peças de um grupo numa coluna só, e um swipe abria uma
 * página alta em vez de mostrar 1 peça. Aqui cada peça é um item de grid
 * independente (`grid-auto-flow: column`), e o botão de avançar rola
 * exatamente uma "tela" — que já contém 1, 2 ou 4 peças conforme o
 * breakpoint, sem precisar saber esse número de antemão.
 *
 * As setas são BOTÕES com um script mínimo (mesmo do resto do site): a
 * versão por âncora (`href="#pagina"`) fazia a página pular na vertical a
 * cada clique — ver histórico do componente.
 */
const pecas = documentos.flatMap((bloco) =>
  bloco.pecas.map((src) => ({ src, alt: bloco.descricao })),
);
---

<section class="docs" aria-labelledby="docs-title">
  <SectionHead
    index="04"
    label="Apresentações e relatórios institucionais"
    id="docs-title"
  />

  <div class="palco" data-slider>
    <div
      class="trilho"
      tabindex="0"
      role="group"
      aria-label="Apresentações e relatórios institucionais — role para o lado para ver mais"
    >
      {pecas.map((peca) => (
        <figure>
          <Image
            src={peca.src}
            alt={peca.alt}
            widths={[340, 560, 760, 950]}
            sizes="(min-width: 64rem) 23vw, (min-width: 40rem) 45vw, 90vw"
            loading="lazy"
          />
        </figure>
      ))}
    </div>

    <button class="seta anterior" type="button" data-anterior aria-label="Ver peças anteriores">
      <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
        <path d="M15 4 7 12l8 8" fill="none" stroke="currentColor" stroke-width="1.5"></path>
      </svg>
    </button>

    <button class="seta proxima" type="button" data-proxima aria-label="Ver mais peças">
      <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
        <path d="M9 4l8 8-8 8" fill="none" stroke="currentColor" stroke-width="1.5"></path>
      </svg>
    </button>
  </div>
</section>

<script>
  // Único script da página. Rola o trilho uma "tela" por clique — só na
  // horizontal, sem tocar na rolagem vertical da janela.
  document.querySelectorAll<HTMLElement>("[data-slider]").forEach((palco) => {
    const trilho = palco.querySelector<HTMLElement>(".trilho");
    const anterior = palco.querySelector<HTMLButtonElement>("[data-anterior]");
    const proxima = palco.querySelector<HTMLButtonElement>("[data-proxima]");
    if (!trilho || !anterior || !proxima) return;

    const anda = (sentido: number) =>
      trilho.scrollBy({ left: trilho.clientWidth * sentido, behavior: "smooth" });

    anterior.addEventListener("click", () => anda(-1));
    proxima.addEventListener("click", () => anda(1));

    // Esconde a seta que não leva a lugar nenhum.
    const atualiza = () => {
      const fim = trilho.scrollWidth - trilho.clientWidth - 1;
      anterior.hidden = trilho.scrollLeft <= 0;
      proxima.hidden = trilho.scrollLeft >= fim;
    };

    trilho.addEventListener("scroll", atualiza, { passive: true });
    window.addEventListener("resize", atualiza);
    atualiza();
  });
</script>

<style>
  .docs {
    padding: var(--section-y) 0;
    /* Encosta na apresentação comercial: as duas seções são o mesmo assunto,
       e o respiro cheio entre elas parecia corte. */
    padding-top: clamp(1.5rem, 3vw, 2.5rem);
  }

  .docs :global(.head) {
    margin-inline: var(--gutter);
  }

  .palco {
    position: relative;
  }

  /* Cada peça é uma coluna independente do grid — não um grupo fixo. A
     largura da coluna é que decide quantas cabem visíveis por vez. */
  .trilho {
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: 100%;
    gap: clamp(0.5rem, 1.5vw, 1rem);
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    overscroll-behavior-x: contain;
    scrollbar-width: none;
    padding-inline: var(--gutter);
  }

  .trilho::-webkit-scrollbar {
    display: none;
  }

  figure {
    scroll-snap-align: start;
    background: var(--bg-alt);
    overflow: hidden;
  }

  figure :global(img) {
    width: 100%;
    height: auto;
  }

  .seta {
    position: absolute;
    top: 50%;
    translate: 0 -50%;
    display: grid;
    place-items: center;
    width: 3rem;
    height: 3rem;
    padding: 0;
    border-radius: 50%;
    background: var(--bg);
    color: var(--ink);
    border: 1px solid var(--line);
    box-shadow: 0 0.5rem 1.5rem rgb(0 0 0 / 0.12);
    cursor: pointer;
    transition:
      background 0.2s ease,
      color 0.2s ease;
  }

  .seta[hidden] {
    display: none;
  }

  .seta svg {
    width: 1.25rem;
    height: 1.25rem;
  }

  .seta:hover {
    background: var(--ink);
    color: var(--bg);
  }

  .anterior {
    left: calc(var(--gutter) / 3);
  }

  .proxima {
    right: calc(var(--gutter) / 3);
  }

  /* 2 peças visíveis por vez a partir do tablet. */
  @media (min-width: 40rem) {
    .trilho {
      grid-auto-columns: calc(50% - clamp(0.5rem, 1.5vw, 1rem) / 2);
    }
  }

  /* 4 peças visíveis por vez a partir do desktop. */
  @media (min-width: 64rem) {
    .trilho {
      grid-auto-columns: calc(25% - clamp(0.5rem, 1.5vw, 1rem) * 3 / 4);
    }
  }
</style>
