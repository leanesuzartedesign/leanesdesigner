---
/**
 * Abertura da página — cortina preta com o nome, que sobe e revela o hero.
 * 100% CSS: `display: none` por padrão, só existe quando o navegador permite
 * movimento. Sem JS, a cortina nunca fica presa na frente do conteúdo — se a
 * animação não rodar, o elemento simplesmente não é exibido.
 */
---

<div class="intro" aria-hidden="true">
  <span class="palavra"><span>Leane Suzarte</span></span>
</div>

<style>
  .intro {
    display: none;
  }

  @media (prefers-reduced-motion: no-preference) {
    .intro {
      display: grid;
      place-items: center;
      position: fixed;
      inset: 0;
      z-index: 100;
      background: var(--dark);
      color: #ffffff;
      /* Sobe e sai; `forwards` deixa a cortina fora da tela no fim.
         Tempo total curto de propósito: a cortina atrasa o LCP, e o
         orçamento para nota 100 no Lighthouse é 2,5s. */
      animation: cortina 0.9s cubic-bezier(0.76, 0, 0.24, 1) 0.35s forwards;
      /* Nunca intercepta clique, nem durante a animação. */
      pointer-events: none;
    }

    .palavra {
      display: block;
      overflow: hidden;
      font-size: clamp(1.75rem, 7vw, 5rem);
      font-weight: 600;
      letter-spacing: -0.03em;
      padding-block: 0.08em;
    }

    .palavra > span {
      display: block;
      animation: sobe 0.7s cubic-bezier(0.16, 1, 0.3, 1) both;
    }
  }

  @keyframes sobe {
    from {
      transform: translateY(110%);
    }
    to {
      transform: none;
    }
  }

  @keyframes cortina {
    to {
      transform: translateY(-100%);
      visibility: hidden;
    }
  }
</style>
