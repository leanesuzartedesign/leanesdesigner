---
import { Image } from "astro:assets";
import SectionHead from "./SectionHead.astro";
import { stories } from "../data/cases";

const pecas = stories.flatMap((b) =>
  b.pecas.map((src) => ({ src, alt: b.descricao })),
);
---

<section class="stories" aria-labelledby="stories-title">
  <SectionHead index="02" label="Stories" id="stories-title" />

  <div class="grade reveal-stagger">
    {
      pecas.map((p, i) => (
        <figure style={`--i:${i % 6}`}>
          <Image
            src={p.src}
            alt={p.alt}
            widths={[300, 520]}
            sizes="(min-width: 64rem) 15vw, (min-width: 40rem) 30vw, 45vw"
            loading="lazy"
          />
        </figure>
      ))
    }
  </div>
</section>

<style>
  .stories {
    padding: var(--section-y) var(--gutter);
  }

  /* São 6 peças: colunas fixas em vez de `auto-fill`, para elas preencherem
     a largura alinhadas, sem sobra na última linha. */
  .grade {
    display: grid;
    gap: clamp(0.5rem, 1.5vw, 1rem);
    grid-template-columns: repeat(2, 1fr);
  }

  @media (min-width: 40rem) {
    .grade {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  @media (min-width: 64rem) {
    .grade {
      grid-template-columns: repeat(6, 1fr);
    }
  }

  figure {
    background: var(--bg-alt);
    overflow: hidden;
  }

  figure :global(img) {
    width: 100%;
    height: auto;
    transition: transform 0.6s cubic-bezier(0.2, 0.8, 0.2, 1);
  }

  @media (hover: hover) {
    figure:hover :global(img) {
      transform: scale(1.03);
    }
  }
</style>
