---
import { Image } from "astro:assets";
import SectionHead from "./SectionHead.astro";
import { faixas } from "../data/cases";

/**
 * Vitrine de posts — duas faixas que correm sozinhas em sentidos opostos,
 * como a terceira seção da referência. Marquee em CSS puro: cada faixa é
 * duplicada e a cópia sai da árvore de acessibilidade, para o leitor de tela
 * não ouvir a lista duas vezes.
 *
 * A duração é proporcional ao número de peças, para as duas faixas correrem
 * na mesma velocidade mesmo tendo tamanhos diferentes.
 */
const linhas = faixas.map((blocos) => {
  const pecas = blocos.flatMap((b) =>
    b.pecas.map((src) => ({ src, alt: b.descricao })),
  );
  return { pecas, duracao: pecas.length * 6 };
});
---

<section class="vitrine" id="posts" aria-labelledby="vitrine-title">
  <SectionHead index="01" label="Posts" id="vitrine-title" />

  <div class="faixas">
    {
      linhas.map((linha, li) => (
        <div class="faixa" style={`--duracao:${linha.duracao}s`} data-sentido={li % 2 === 0 ? "esquerda" : "direita"}>
          {[0, 1].map((copia) => (
            <ul class="trilha" aria-hidden={copia === 1 ? "true" : undefined}>
              {linha.pecas.map((p) => (
                <li>
                  <Image
                    src={p.src}
                    alt={copia === 1 ? "" : p.alt}
                    widths={[220, 400, 600]}
                    sizes="(min-width: 48rem) 18rem, 12rem"
                    loading="lazy"
                  />
                </li>
              ))}
            </ul>
          ))}
        </div>
      ))
    }
  </div>
</section>

<style>
  .vitrine {
    padding: var(--section-y) 0;
    /* As faixas são mais largas que a tela de propósito — o corte tem que
       acontecer aqui, senão a página inteira ganha scroll horizontal. */
    overflow: hidden;
  }

  .vitrine :global(.head) {
    margin-inline: var(--gutter);
  }

  .faixas {
    display: grid;
    gap: clamp(0.5rem, 1.5vw, 1rem);
  }

  .faixa {
    display: flex;
    width: max-content;
    gap: clamp(0.5rem, 1.5vw, 1rem);
  }

  .trilha {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    gap: clamp(0.5rem, 1.5vw, 1rem);
  }

  .trilha li {
    width: clamp(9rem, 22vw, 18rem);
    flex: 0 0 auto;
    background: var(--bg-alt);
    overflow: hidden;
  }

  .trilha :global(img) {
    width: 100%;
    height: auto;
  }

  @media (prefers-reduced-motion: no-preference) {
    .faixa[data-sentido="esquerda"] {
      animation: corre-esquerda var(--duracao) linear infinite;
    }

    .faixa[data-sentido="direita"] {
      animation: corre-direita var(--duracao) linear infinite;
    }

    /* Passar o mouse segura a faixa para dar tempo de olhar a peça. */
    .faixa:hover {
      animation-play-state: paused;
    }
  }

  /* -50% e não -100%: a faixa tem duas cópias, então meio caminho já
     recoloca a primeira exatamente onde ela começou. */
  @keyframes corre-esquerda {
    to {
      transform: translateX(calc(-50% - clamp(0.25rem, 0.75vw, 0.5rem)));
    }
  }

  @keyframes corre-direita {
    from {
      transform: translateX(calc(-50% - clamp(0.25rem, 0.75vw, 0.5rem)));
    }
    to {
      transform: none;
    }
  }

  /* Sem animação, a faixa vira um slider que a pessoa arrasta. */
  @media (prefers-reduced-motion: reduce) {
    .faixas {
      overflow-x: auto;
      scroll-snap-type: x proximity;
      padding-inline: var(--gutter);
    }

    .trilha li {
      scroll-snap-align: start;
    }
  }
</style>
